# episcaf data-mover worker config. Copy to ~/.episcaf-pilot/worker.env on the Gemini data mover
# and fill in the bucket names. This file holds configuration, not the key itself; keep it 0600.
#   cp episcaf_service/gcloud/worker.env.example ~/.episcaf-pilot/worker.env && chmod 600 ~/.episcaf-pilot/worker.env
#
# The two buckets are named by project number (same ones Cloud Run uses):
#   number=$(gcloud projects describe "$(gcloud config get-value project)" --format='value(projectNumber)')
#   -> episcaf-requests-$number and episcaf-results-$number

EPISCAF_REQUEST_BUCKET=episcaf-requests-PROJECT_NUMBER
EPISCAF_RESULT_BUCKET=episcaf-results-PROJECT_NUMBER

# Optional overrides (defaults shown):
# EPISCAF_REPO=$HOME/episcaf-advisor
# EPISCAF_CLOUD_SDK_SIF=$HOME/.episcaf-pilot/cloud-sdk.sif
# EPISCAF_SA_KEY=$HOME/.episcaf-pilot/sa-key.json
# EPISCAF_SBATCH=$HOME/episcaf-advisor/episcaf_service/handoff.sbatch
# EPISCAF_INBOX=$HOME/.episcaf-pilot/inbox
# EPISCAF_GRACE_SECONDS=900
